+// See include/fast/vr_frame_diag.h. Steam Frame build only.
+#ifdef SOH_STEAM_FRAME
+
+#include "fast/vr_frame_diag.h"
+#include "fast/vr_wait.h"
+
+#include <cctype>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include <sys/stat.h>
+
+#ifndef VR_FRAME_DIAG_HOST_TEST
+#include <spdlog/spdlog.h>
+#include "ship/Context.h"
+#endif
+
+namespace {
+
+bool parse_bool(const char* v) {
+    return v[0] == '1' || v[0] == 't' || v[0] == 'T' || v[0] == 'y' || v[0] == 'Y' || strncmp(v, "on", 2) == 0 ||
+           strncmp(v, "ON", 2) == 0;
+}
+
+// "on"/"yes"/"true" mean 1, a number is taken as it is (timing=2 asks for the detailed mode).
+int parse_level(const char* v) {
+    if (v[0] >= '0' && v[0] <= '9') return atoi(v);
+    return parse_bool(v) ? 1 : 0;
+}
+
+void apply(VrFrameDiag* d, const char* key, const char* val, void (*unknown)(const char*)) {
+    if (!strcmp(key, "force_render")) {
+        d->force_render = parse_bool(val);
+    } else if (!strcmp(key, "diag_yaw")) {
+        d->diag_yaw = static_cast<float>(atof(val));
+    } else if (!strcmp(key, "dump_frame")) {
+        d->dump_frame = atoi(val);
+    } else if (!strcmp(key, "timing") || !strcmp(key, "timing_gpu")) {
+        d->timing = parse_level(val);
+    } else if (!strcmp(key, "autostart")) {
+        d->autostart = parse_bool(val);
+    } else if (!strcmp(key, "stereo_divisor")) {
+        d->stereo_divisor = atoi(val);
+        if (d->stereo_divisor < 0) d->stereo_divisor = 0;
+        if (d->stereo_divisor > 4) d->stereo_divisor = 4;
+    } else if (!strcmp(key, "autostart_entrance")) {
+        d->autostart_entrance = static_cast<int>(strtol(val, nullptr, 0));
+    } else if (!strcmp(key, "autostart_slot")) {
+        d->autostart_slot = atoi(val);
+        if (d->autostart_slot < 0 || d->autostart_slot > 3) d->autostart_slot = 0;
+    } else if (!strcmp(key, "autostart_new_game")) {
+        d->autostart_new_game = parse_bool(val);
+    } else if (!strcmp(key, "diag_roll")) {
+        d->diag_roll = static_cast<float>(atof(val));
+    } else if (!strcmp(key, "diag_pause_at")) {
+        d->diag_pause_at = static_cast<float>(atof(val));
+        if (d->diag_pause_at < 0.0f) d->diag_pause_at = 0.0f;
+    } else if (!strcmp(key, "refresh_rate")) {
+        d->refresh_rate = atoi(val);
+        if (d->refresh_rate < 0) d->refresh_rate = 0;
+    } else if (!strcmp(key, "resolution_scale")) {
+        d->resolution_scale = static_cast<float>(atof(val));
+        if (d->resolution_scale != 0.0f && d->resolution_scale < 0.75f) d->resolution_scale = 0.75f;
+        if (d->resolution_scale > 1.5f) d->resolution_scale = 1.5f;
+        if (d->resolution_scale < 0.0f) d->resolution_scale = 0.0f;
+    } else if (!strcmp(key, "diag_menu_open")) {
+        d->diag_menu_open = parse_bool(val);
+    } else if (!strcmp(key, "dump_at")) {
+        d->dump_at = static_cast<float>(atof(val));
+        if (d->dump_at < 0.0f) d->dump_at = 0.0f;
+    } else if (!strcmp(key, "dump_when")) {
+        d->dump_when = val;
+        for (auto& c : d->dump_when) c = static_cast<char>(tolower(static_cast<unsigned char>(c)));
+    } else if (!strcmp(key, "dump_count")) {
+        d->dump_count = atoi(val);
+        if (d->dump_count < 1) d->dump_count = 1;
+        if (d->dump_count > 50) d->dump_count = 50;
+    } else if (!strcmp(key, "dump_every")) {
+        d->dump_every = atoi(val);
+        if (d->dump_every < 1) d->dump_every = 1;
+    } else if (unknown) {
+        unknown(key);
+    }
+}
+
+std::string trim(const std::string& s) {
+    size_t b = 0, e = s.size();
+    while (b < e && (s[b] == ' ' || s[b] == '\t')) b++;
+    while (e > b && (s[e - 1] == ' ' || s[e - 1] == '\t' || s[e - 1] == '\r' || s[e - 1] == '\n')) e--;
+    return s.substr(b, e - b);
+}
+
+} // namespace
+
+void vr_frame_diag_parse(const char* text, VrFrameDiag* out, void (*unknown)(const char* key)) {
+    if (!text || !out) return;
+    const char* p = text;
+    while (*p) {
+        const char* nl = strchr(p, '\n');
+        std::string line = nl ? std::string(p, nl - p) : std::string(p);
+        p = nl ? nl + 1 : p + line.size();
+        line = trim(line);
+        if (line.empty() || line[0] == '#' || line[0] == ';' || line[0] == '[') continue;
+        const size_t eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        const std::string key = trim(line.substr(0, eq));
+        const std::string val = trim(line.substr(eq + 1));
+        apply(out, key.c_str(), val.c_str(), unknown);
+    }
+}
+
+void vr_frame_synth_head(const VrFrameDiag& d, float head_pos[3], float head_quat[4]) {
+    // yaw about +Y, then roll about the head's own forward axis (+Z of the head frame)
+    const float yaw = d.diag_yaw * 3.14159265358979f / 180.0f;
+    const float roll = d.diag_roll * 3.14159265358979f / 180.0f;
+    const float sy = std::sin(yaw * 0.5f), cy = std::cos(yaw * 0.5f);
+    const float sr = std::sin(roll * 0.5f), cr = std::cos(roll * 0.5f);
+    head_pos[0] = 0.0f;
+    head_pos[1] = 1.6f;
+    head_pos[2] = 0.0f;
+    // (0, sy, 0, cy) * (0, 0, sr, cr)
+    head_quat[0] = sy * sr;
+    head_quat[1] = sy * cr;
+    head_quat[2] = cy * sr;
+    head_quat[3] = cy * cr;
+}
+
+void vr_frame_synth_eye(const VrFrameDiag& d, int eye, float pos[3], float quat[4]) {
+    float hp[3], hq[4];
+    vr_frame_synth_head(d, hp, hq);
+    // The head's right vector (+X rotated by the head orientation): yaw, then roll.
+    const float yaw = d.diag_yaw * 3.14159265358979f / 180.0f;
+    const float roll = d.diag_roll * 3.14159265358979f / 180.0f;
+    const float side = (eye == 0 ? -0.032f : 0.032f);
+    // roll about Z: (cos r, sin r, 0); then yaw about Y: (x cos y, y, -x sin y)
+    const float rx = std::cos(roll), ry = std::sin(roll);
+    pos[0] = hp[0] + side * rx * std::cos(yaw);
+    pos[1] = hp[1] + side * ry;
+    pos[2] = hp[2] - side * rx * std::sin(yaw);
+    for (int i = 0; i < 4; i++) quat[i] = hq[i];
+}
+
+bool vr_frame_write_bmp24(const char* path, const uint8_t* rgba, int w, int h, unsigned* opaque_pct) {
+    FILE* f = fopen(path, "wb");
+    if (!f) return false;
+    const int row_bytes = (w * 3 + 3) & ~3;
+    const uint32_t image_size = static_cast<uint32_t>(row_bytes) * static_cast<uint32_t>(h);
+    const uint32_t file_size = 54 + image_size;
+    uint8_t hdr[54] = { 'B', 'M' };
+    const uint32_t off = 54, dib = 40;
+    const uint16_t planes = 1, bpp = 24;
+    memcpy(hdr + 2, &file_size, 4);
+    memcpy(hdr + 10, &off, 4);
+    memcpy(hdr + 14, &dib, 4);
+    memcpy(hdr + 18, &w, 4);
+    memcpy(hdr + 22, &h, 4); // positive height: rows bottom-up, which is GL's read order
+    memcpy(hdr + 26, &planes, 2);
+    memcpy(hdr + 28, &bpp, 2);
+    memcpy(hdr + 34, &image_size, 4);
+    fwrite(hdr, 1, sizeof(hdr), f);
+    std::vector<uint8_t> row(static_cast<size_t>(row_bytes), 0);
+    unsigned long opaque = 0;
+    for (int y = 0; y < h; y++) {
+        const uint8_t* src = rgba + static_cast<size_t>(y) * w * 4;
+        for (int x = 0; x < w; x++) {
+            row[static_cast<size_t>(x) * 3 + 0] = src[x * 4 + 2];
+            row[static_cast<size_t>(x) * 3 + 1] = src[x * 4 + 1];
+            row[static_cast<size_t>(x) * 3 + 2] = src[x * 4 + 0];
+            if (src[x * 4 + 3] >= 250) opaque++;
+        }
+        fwrite(row.data(), 1, static_cast<size_t>(row_bytes), f);
+    }
+    const bool ok = fclose(f) == 0;
+    if (opaque_pct && w > 0 && h > 0) {
+        *opaque_pct = static_cast<unsigned>(opaque * 100ull / (static_cast<unsigned long>(w) * static_cast<unsigned long>(h)));
+    }
+    return ok;
+}
+
+#ifndef VR_FRAME_DIAG_HOST_TEST
+
+namespace {
+void log_unknown(const char* key) {
+    spdlog::warn("[vr-diag] unknown key '{}'", key);
+}
+} // namespace
+
+const VrFrameDiag& vr_frame_diag() {
+    static VrFrameDiag diag;
+    static bool loaded = false;
+    if (!loaded) {
+        loaded = true;
+        const std::string path = Ship::Context::GetAppDirectoryPath() + "/vr-diag.ini";
+        if (FILE* f = fopen(path.c_str(), "rb")) {
+            std::string text;
+            char buf[512];
+            size_t n;
+            while ((n = fread(buf, 1, sizeof(buf), f)) > 0) text.append(buf, n);
+            fclose(f);
+            diag.present = true;
+            vr_frame_diag_parse(text.c_str(), &diag, log_unknown);
+        }
+        g_vr_wait_on = diag.timing >= 2;
+        spdlog::info("[vr-diag] {} {}: force_render={} diag_yaw={:.1f} dump_frame={} timing={} autostart={} "
+                     "autostart_entrance=0x{:x} stereo_divisor={}",
+                     path, diag.present ? "read" : "absent", diag.force_render, diag.diag_yaw, diag.dump_frame,
+                     diag.timing, diag.autostart, diag.autostart_entrance, diag.stereo_divisor);
+    }
+    return diag;
+}
+
+std::string vr_frame_dump_dir() {
+    const std::string dir = Ship::Context::GetAppDirectoryPath() + "/vr-dumps";
+    mkdir(dir.c_str(), 0777);
+    return dir;
+}
+
+#endif // VR_FRAME_DIAG_HOST_TEST
+
+#endif // SOH_STEAM_FRAME
