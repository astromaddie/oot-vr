+namespace {
+
+void quat_rotate(const float q[4], const float v[3], float out[3]) {
+    // out = q * v * q^-1, with t = 2 * cross(q.xyz, v)
+    const float tx = 2.0f * (q[1] * v[2] - q[2] * v[1]);
+    const float ty = 2.0f * (q[2] * v[0] - q[0] * v[2]);
+    const float tz = 2.0f * (q[0] * v[1] - q[1] * v[0]);
+    out[0] = v[0] + q[3] * tx + (q[1] * tz - q[2] * ty);
+    out[1] = v[1] + q[3] * ty + (q[2] * tx - q[0] * tz);
+    out[2] = v[2] + q[3] * tz + (q[0] * ty - q[1] * tx);
+}
+
+void quat_mul(const float a[4], const float b[4], float out[4]) {
+    const float x = a[3] * b[0] + a[0] * b[3] + a[1] * b[2] - a[2] * b[1];
+    const float y = a[3] * b[1] - a[0] * b[2] + a[1] * b[3] + a[2] * b[0];
+    const float z = a[3] * b[2] + a[0] * b[1] - a[1] * b[0] + a[2] * b[3];
+    const float w = a[3] * b[3] - a[0] * b[0] - a[1] * b[1] - a[2] * b[2];
+    out[0] = x;
+    out[1] = y;
+    out[2] = z;
+    out[3] = w;
+}
+
+void quat_yaw(float yaw, float out[4]) {
+    out[0] = 0.0f;
+    out[1] = std::sin(yaw * 0.5f);
+    out[2] = 0.0f;
+    out[3] = std::cos(yaw * 0.5f);
+}
+
+// Yaw (about +Y) that turns -Z into the horizontal direction (x, z).
+float yaw_of(float x, float z) {
+    return std::atan2(-x, -z);
+}
+
+} // namespace
+
+void vr_present_strip_roll(const float q[4], float out[4]) {
+    const float fwd_in[3] = { 0.0f, 0.0f, -1.0f };
+    float f[3];
+    quat_rotate(q, fwd_in, f);
+    const float horiz = std::sqrt(f[0] * f[0] + f[2] * f[2]);
+    float yaw;
+    if (horiz > 1e-4f) {
+        yaw = yaw_of(f[0], f[2]);
+    } else {
+        // Straight up or down: the head's up vector lies in the horizontal plane and points
+        // forward (looking down) or backward (looking up).
+        const float up_in[3] = { 0.0f, 1.0f, 0.0f };
+        float u[3];
+        quat_rotate(q, up_in, u);
+        yaw = f[1] < 0.0f ? yaw_of(u[0], u[2]) : yaw_of(-u[0], -u[2]);
+    }
+    float fy = f[1];
+    if (fy > 1.0f) fy = 1.0f;
+    if (fy < -1.0f) fy = -1.0f;
+    const float pitch = std::asin(fy);
+    float qy[4];
+    quat_yaw(yaw, qy);
+    const float qp[4] = { std::sin(pitch * 0.5f), 0.0f, 0.0f, std::cos(pitch * 0.5f) };
+    quat_mul(qy, qp, out);
+}
+
+VrPresentPose vr_present_head_locked(const VrPresentPose& head, float off_x, float off_y, float dist) {
+    VrPresentPose out;
+    vr_present_strip_roll(head.quat, out.quat);
+    const float local[3] = { off_x, off_y, -dist };
+    float d[3];
+    quat_rotate(out.quat, local, d);
+    for (int i = 0; i < 3; i++) {
+        out.pos[i] = head.pos[i] + d[i];
+    }
+    return out;
+}
+
+VrCinemaScreen vr_cinema_place(const VrPresentPose& head, float distance, float width, float aspect) {
+    VrCinemaScreen s;
+    const float fwd_in[3] = { 0.0f, 0.0f, -1.0f };
+    float f[3];
+    quat_rotate(head.quat, fwd_in, f);
+    float hx = f[0], hz = f[2];
+    const float len = std::sqrt(hx * hx + hz * hz);
+    if (len > 1e-4f) {
+        hx /= len;
+        hz /= len;
+    } else {
+        hx = 0.0f;
+        hz = -1.0f;
+    }
+    quat_yaw(yaw_of(hx, hz), s.pose.quat);
+    s.pose.pos[0] = head.pos[0] + hx * distance;
+    s.pose.pos[1] = head.pos[1];
+    s.pose.pos[2] = head.pos[2] + hz * distance;
+    s.width = width;
+    s.height = width / (aspect > 0.1f ? aspect : 16.0f / 9.0f);
+    return s;
+}
+
+bool vr_cinema_eye_view(const VrCinemaScreen& s, const float eye_pos[3], VrPresentPose* out_pose,
+                        VrPresentFov* out_fov) {
+    // The eye in the screen's frame: rotate (eye - centre) by the screen's inverse orientation.
+    const float d[3] = { eye_pos[0] - s.pose.pos[0], eye_pos[1] - s.pose.pos[1], eye_pos[2] - s.pose.pos[2] };
+    const float inv[4] = { -s.pose.quat[0], -s.pose.quat[1], -s.pose.quat[2], s.pose.quat[3] };
+    float e[3];
+    quat_rotate(inv, d, e);
+    // The picture faces +Z; an eye in front of it has e.z > 0.
+    if (!(e[2] > 0.1f)) {
+        return false;
+    }
+    const float hw = 0.5f * s.width, hh = 0.5f * s.height;
+    out_fov->left = std::atan2(-hw - e[0], e[2]);
+    out_fov->right = std::atan2(hw - e[0], e[2]);
+    out_fov->down = std::atan2(-hh - e[1], e[2]);
+    out_fov->up = std::atan2(hh - e[1], e[2]);
+    for (int i = 0; i < 3; i++) {
+        out_pose->pos[i] = eye_pos[i];
+    }
+    for (int i = 0; i < 4; i++) {
+        out_pose->quat[i] = s.pose.quat[i];
+    }
+    return true;
+}
+
+float vr_cinema_ndc_disparity(float ipd_m, float depth, float screen_width_m) {
+    if (!(screen_width_m > 0.01f)) {
+        return 0.0f;
+    }
+    if (depth < 0.0f) depth = 0.0f;
+    if (depth > 1.0f) depth = 1.0f;
+    // NDC spans 2 across the screen's width, so d metres on the screen are 2*d/W in NDC.
+    return 2.0f * depth * ipd_m / screen_width_m;
+}
+
+void vr_cinema_eye_matrix(const float P[4][4], int eye, float ndc_disparity, float convergence_w, float aspect_mul,
+                          float out[4][4]) {
+    for (int r = 0; r < 4; r++) {
+        for (int c = 0; c < 4; c++) {
+            out[r][c] = P[r][c];
+        }
+    }
+    for (int r = 0; r < 4; r++) {
+        out[r][0] *= aspect_mul;
+    }
+    // Perspective iff w depends on the position (row-vector: column 3 of rows 0..2).
+    const bool perspective =
+        std::fabs(P[0][3]) + std::fabs(P[1][3]) + std::fabs(P[2][3]) > 1e-6f * (std::fabs(P[3][3]) + 1.0f);
+    if (!perspective || ndc_disparity == 0.0f) {
+        return;
+    }
+    const float k = (eye == 0 ? -0.5f : 0.5f) * ndc_disparity;
+    // x' = x + k * w - k * convergence_w: the w column folded into x, and the constant on the
+    // homogeneous row (row 3 multiplies the input's w = 1).
+    for (int r = 0; r < 4; r++) {
+        out[r][0] += k * P[r][3];
+    }
+    out[3][0] -= k * convergence_w;
+}
+
+float vr_cinema_near_w(const float P[4][4]) {
+    // Row-vector perspective with a look-at M in front: column 3 (w) = -M's view-z column and
+    // column 2 = a * that column + b on the homogeneous row, so a and b come out of P directly.
+    int best = -1;
+    float big = 0.0f;
+    for (int r = 0; r < 3; r++) {
+        if (std::fabs(P[r][3]) > big) {
+            big = std::fabs(P[r][3]);
+            best = r;
+        }
+    }
+    if (best < 0 || big < 1e-9f) {
+        return 0.0f; // orthographic
+    }
+    const float a = -P[best][2] / P[best][3];
+    const float b = P[3][2] + a * P[3][3];
+    if (std::fabs(a - 1.0f) < 1e-9f) {
+        return 0.0f;
+    }
+    const float n = b / (a - 1.0f);
+    return n > 0.0f ? n : 0.0f;
+}
+
+float vr_cinema_convergence_step(float conv, bool have, float nearest_w, float near_w) {
+    float target = nearest_w > 0.0f ? nearest_w : (have ? conv : 150.0f);
+    if (target < near_w) target = near_w;
+    if (!have) {
+        return target;
+    }
+    // Nearer content: most of the way within ~3 frames (a window violation is the worse error).
+    // Farther content: slowly, so the depth does not pump with every shot.
+    const float k = target < conv ? 0.5f : 0.04f;
+    float c = conv + (target - conv) * k;
+    if (c < near_w) c = near_w;
+    return c;
+}
+
+uint32_t vr_eye_size(uint32_t recommended_px, uint32_t max_px, float user_scale, uint32_t target_px) {
+    if (recommended_px == 0) {
+        return 0;
+    }
+    if (user_scale < 0.75f) user_scale = 0.75f;
+    if (user_scale > 1.5f) user_scale = 1.5f;
+    const float base = recommended_px < target_px ? static_cast<float>(target_px) / recommended_px : 1.0f;
+    double px = std::floor(recommended_px * base * user_scale + 0.5);
+    if (px < 1.0) px = 1.0;
+    if (max_px > 0 && px > max_px) px = max_px;
+    return static_cast<uint32_t>(px);
+}
+
+float vr_refresh_pick(const float* offered, int n, float limit_hz) {
+    float best = 0.0f, lowest = 0.0f;
+    for (int i = 0; i < n; i++) {
+        const float r = offered[i];
+        if (r <= 0.0f) continue;
+        if (lowest == 0.0f || r < lowest) lowest = r;
+        if (r <= limit_hz + 0.5f && r > best) best = r;
+    }
+    return best > 0.0f ? best : lowest;
+}
+
+float vr_refresh_fallback(const float* offered, int n, float current_hz) {
+    float highest_below = 0.0f;
+    bool has90 = false, has72 = false;
+    for (int i = 0; i < n; i++) {
+        const float r = offered[i];
+        if (r >= current_hz - 0.5f || r <= 0.0f) continue;
+        if (r > highest_below) highest_below = r;
+        has90 |= std::fabs(r - 90.0f) < 0.5f;
+        has72 |= std::fabs(r - 72.0f) < 0.5f;
+    }
+    if (current_hz > 90.5f && has90) return 90.0f;
+    if (current_hz > 72.5f && has72) return 72.0f;
+    return highest_below >= 71.5f ? highest_below : 0.0f;
+}
+
+bool vr_refresh_governor_frame(VrRefreshGovernor* g, double now_s, float rate_hz, bool worn) {
+    if (!worn || rate_hz <= 0.0f) {
+        // Off the head (or forced rendering on a desk): the windows only count worn time.
+        g->window_start_s = -1.0;
+        g->frames = 0;
+        g->low_windows = 0;
+        return false;
+    }
+    if (g->window_start_s < 0.0) {
+        g->window_start_s = now_s;
+        g->frames = 0;
+        return false;
+    }
+    g->frames++;
+    const double t = now_s - g->window_start_s;
+    if (t < 10.0) {
+        return false;
+    }
+    g->last_fps = static_cast<float>(g->frames / t);
+    g->window_start_s = now_s;
+    g->frames = 0;
+    if (g->last_fps < 0.9f * rate_hz) {
+        if (++g->low_windows >= 2) {
+            g->low_windows = 0;
+            return true;
+        }
+    } else {
+        g->low_windows = 0;
+    }
+    return false;
+}
+
+void vr_present_fade_trigger(VrPresentFade* f, double now_s) {
+    f->start_s = now_s;
+}
+
+float vr_present_fade_black(VrPresentFade* f, double now_s) {
+    if (f->start_s < 0.0) {
+        return 0.0f;
+    }
+    const double t = now_s - f->start_s;
+    if (t < 0.0 || t < kVrFadeHoldS) {
+        return 1.0f;
+    }
+    const double u = (t - kVrFadeHoldS) / kVrFadeInS;
+    if (u >= 1.0) {
+        f->start_s = -1.0;
+        return 0.0f;
+    }
+    return static_cast<float>(1.0 - u);
+}
+
+VrPresentMode vr_present_decide(const VrPresentInputs& in, char* why, size_t why_len) {
+    const bool cutscene = in.cs_active || in.intro_cs || in.title_demo || (in.player_cs_mode && in.cam_cutscene);
+    VrPresentMode mode = VR_PRESENT_IMMERSIVE;
+    const char* because = "gameplay";
+    if (in.prerender_room && in.prerender_setting_cinema) {
+        mode = VR_PRESENT_CINEMA_FLAT;
+        because = "pre-rendered room";
+    } else if (cutscene && in.cutscene_setting_cinema) {
+        mode = VR_PRESENT_CINEMA;
+        because = "cutscene";
+    } else if (cutscene) {
+        because = "cutscene, but CUTSCENES = IMMERSIVE";
+    } else if (in.prerender_room) {
+        because = "pre-rendered room, but its cinema setting is off";
+    } else if (in.player_cs_mode || in.talking) {
+        because = "Link held by the game with the gameplay camera (talk, item)";
+    }
+    if (why && why_len > 0) {
+        snprintf(why, why_len,
+                 "%s (%s): csCtx=%d playerCs=%d camCutscene=%d introCs=%d titleDemo=%d prerender=%d talking=%d "
+                 "setting=%s prerenderSetting=%s",
+                 mode == VR_PRESENT_IMMERSIVE ? "immersive"
+                 : mode == VR_PRESENT_CINEMA  ? "3D cinema"
+                                              : "flat cinema",
+                 because, in.cs_active, in.player_cs_mode, in.cam_cutscene, in.intro_cs, in.title_demo,
+                 in.prerender_room, in.talking, in.cutscene_setting_cinema ? "3D CINEMA" : "IMMERSIVE",
+                 in.prerender_setting_cinema ? "on" : "off");
+    }
+    return mode;
+}
+
+#endif // SOH_STEAM_FRAME
