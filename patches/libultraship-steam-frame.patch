index 00000000..9d2cddec
--- /dev/null
+++ b/src/fast/vr_system.cpp
@@ -0,0 +1,90 @@
+// See include/fast/vr_system.h. Steam Frame build only.
+#ifdef SOH_STEAM_FRAME
+
+#include "fast/vr_system.h"
+
+#include "sfvr/sfvr_view.h"
+
+namespace {
+sfvr_view_button s_view;
+double s_chord_start_s = -1.0;  // when View and Menu were both down, <0 = not both down
+bool s_chord_fired = false;     // this chord already toggled the menu
+double s_back_until_s = -1.0;
+bool s_menu_was_down = false;
+bool s_view_touched = false;    // View was down at some point while this Menu press lasted
+double s_menu_until_s = -1.0;
+} // namespace
+
+void vr_system_reset() {
+    sfvr_view_reset(&s_view);
+    s_chord_start_s = -1.0;
+    s_chord_fired = false;
+    s_menu_was_down = false;
+    s_view_touched = false;
+}
+
+VrSysOut vr_system_step(const VrSysIn& in) {
+    VrSysOut out;
+    if (!in.focused) {
+        vr_system_reset();
+        return out;
+    }
+
+    // The chord first: if it fires, the View press that is part of it must not also recentre
+    // or go Back. sfvr_view_reset() makes the still-held button "already down when we started
+    // looking", which sfvr ignores until it is released.
+    if (in.view && in.menu) {
+        if (s_chord_start_s < 0.0) {
+            s_chord_start_s = in.now_s;
+        }
+        if (!s_chord_fired && in.now_s - s_chord_start_s >= kVrSysChordHoldS) {
+            s_chord_fired = true;
+            out.toggle_settings = true;
+            sfvr_view_reset(&s_view);
+        }
+    } else {
+        s_chord_start_s = -1.0;
+        s_chord_fired = false;
+    }
+
+    // Menu is a tap: Start fires when it is released, and only if View stayed out of it.
+    if (in.menu) {
+        if (!s_menu_was_down) {
+            s_view_touched = false;
+        }
+        s_menu_was_down = true;
+        if (in.view) {
+            s_view_touched = true;
+        }
+    } else if (s_menu_was_down) {
+        s_menu_was_down = false;
+        if (!s_view_touched) {
+            out.menu_tap = true;
+            s_menu_until_s = in.now_s + kVrSysBackPulseS;
+        }
+        s_view_touched = false;
+    }
+
+    const unsigned ev = sfvr_view_update(&s_view, nullptr, in.view ? 1 : 0, in.now_s);
+    if (ev & SFVR_VIEW_SHORT_PRESS) {
+        out.back = true;
+        s_back_until_s = in.now_s + kVrSysBackPulseS;
+    }
+    if (ev & SFVR_VIEW_RECENTRE) {
+        out.recentre = true;
+    }
+    if (ev & SFVR_VIEW_RECALIBRATE_HEIGHT) {
+        out.recalibrate = true;
+    }
+    return out;
+}
+
+bool vr_system_back_pulse(double now_s) {
+    return now_s < s_back_until_s;
+}
+
+bool vr_system_menu_pulse(double now_s) {
+    return now_s < s_menu_until_s;
+}
+
+#endif // SOH_STEAM_FRAME
