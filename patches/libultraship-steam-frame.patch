+// See include/fast/vr_frame.h. Steam Frame build only.
+#ifdef SOH_STEAM_FRAME
+
+#include "fast/vr_frame.h"
+#include "fast/vr_frame_diag.h"
+#include "fast/vr_wait.h"
+
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <EGL/egl.h>
+#include <GLES3/gl3.h>
+#include <spdlog/spdlog.h>
+
+#include "sfvr/sfvr_perf.h"
+
+// ---------------------------------------------------------------------------------- dumps
+
+namespace {
+uint64_t s_dump_frame_no = 0;   // this XR frame
+int s_dump_kind = 0;            // this frame's presentation kind (0 immersive, 1 3D cinema, 2 flat cinema, 3 panel)
+bool s_dump_frame_armed = false; // decided at the first query of this frame
+bool s_dump_frame_decided = false;
+int s_dumps_written = 0;        // complete dumps written this run
+uint64_t s_last_dump_frame = 0;
+bool s_dump_wrote_any = false;  // this frame wrote at least one image
+bool s_dump_eye_ok[2] = { false, false };
+bool s_dump_eyes_tried = false;
+unsigned s_dump_opaque[2] = { 0, 0 };
+int s_dump_w = 0, s_dump_h = 0;
+std::string s_dump_images;      // names written this frame, for the log line
+int s_dump_failures = 0;
+int s_dump_waits = 0;           // armed frames that drew nothing (logged now and then)
+double s_gameplay_start_s = -1.0;
+bool s_dump_gave_up = false;
+
+double now_s() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+bool kind_matches(const std::string& when, int kind) {
+    if (when.empty() || when == "any") return true;
+    if (when == "immersive" || when == "world") return kind == 0;
+    if (when == "cinema") return kind == 1 || kind == 2;
+    if (when == "cinema3d" || when == "3d_cinema") return kind == 1;
+    if (when == "flat_cinema" || when == "prerender") return kind == 2;
+    if (when == "panel" || when == "pause") return kind == 3;
+    return true;
+}
+
+// The suffix of this dump's files: "" for the first, "-2", "-3", ... for a series (dump_count).
+std::string dump_suffix() {
+    if (s_dumps_written == 0) return "";
+    return "-" + std::to_string(s_dumps_written + 1);
+}
+} // namespace
+
+void vr_frame_note_gameplay() {
+    if (s_gameplay_start_s < 0.0) {
+        s_gameplay_start_s = now_s();
+        spdlog::info("[vr-diag] gameplay started (dump_at / diag_pause_at count from here)");
+    }
+}
+
+double vr_frame_gameplay_seconds() {
+    return s_gameplay_start_s < 0.0 ? -1.0 : now_s() - s_gameplay_start_s;
+}
+
+void vr_frame_dump_begin(uint64_t xr_frame) {
+    s_dump_frame_no = xr_frame;
+    s_dump_frame_decided = false;
+    s_dump_frame_armed = false;
+    s_dump_wrote_any = false;
+    s_dump_eye_ok[0] = s_dump_eye_ok[1] = false;
+    s_dump_eyes_tried = false;
+    s_dump_images.clear();
+}
+
+void vr_frame_dump_set_kind(int kind) {
+    s_dump_kind = kind;
+}
+
+bool vr_frame_dump_due() {
+    if (s_dump_frame_decided) return s_dump_frame_armed;
+    s_dump_frame_decided = true;
+    const VrFrameDiag& d = vr_frame_diag();
+    const int count = d.dump_count > 0 ? d.dump_count : 1;
+    if (s_dump_gave_up || s_dumps_written >= count) return false;
+    if (d.dump_frame <= 0 && d.dump_at <= 0.0f) return false;
+    if (d.dump_frame > 0 && s_dump_frame_no < static_cast<uint64_t>(d.dump_frame)) return false;
+    if (d.dump_at > 0.0f) {
+        const double t = vr_frame_gameplay_seconds();
+        if (t < 0.0 || t < d.dump_at) return false;
+    }
+    if (s_dumps_written > 0) {
+        const int every = d.dump_every > 0 ? d.dump_every : 90;
+        if (s_dump_frame_no < s_last_dump_frame + static_cast<uint64_t>(every)) return false;
+    }
+    if (!kind_matches(d.dump_when, s_dump_kind)) return false;
+    s_dump_frame_armed = true;
+    return true;
+}
+
+static bool read_layer(GLuint fbo, unsigned tex, int layer, bool layered, int w, int h, const std::string& name,
+                       unsigned* opaque) {
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo);
+    if (layered) {
+        glFramebufferTextureLayer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, tex, 0, layer);
+    } else {
+        glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+    }
+    const GLenum st = glCheckFramebufferStatus(GL_READ_FRAMEBUFFER);
+    if (st != GL_FRAMEBUFFER_COMPLETE) {
+        spdlog::warn("[vr-dump] read framebuffer for {} incomplete (0x{:x})", name, st);
+        return false;
+    }
+    std::vector<uint8_t> px(static_cast<size_t>(w) * h * 4);
+    GLint prev_align = 4;
+    glGetIntegerv(GL_PACK_ALIGNMENT, &prev_align);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadBuffer(GL_COLOR_ATTACHMENT0);
+    // Errors the renderer left pending must not be mistaken for this read's.
+    for (int n = 0; n < 16 && glGetError() != GL_NO_ERROR; n++) {
+    }
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, px.data());
+    const GLenum err = glGetError();
+    glPixelStorei(GL_PACK_ALIGNMENT, prev_align);
+    if (err != GL_NO_ERROR) {
+        spdlog::warn("[vr-dump] glReadPixels failed 0x{:x} for {}", err, name);
+        return false;
+    }
+    const std::string path = vr_frame_dump_dir() + "/" + name;
+    if (!vr_frame_write_bmp24(path.c_str(), px.data(), w, h, opaque)) {
+        spdlog::warn("[vr-dump] cannot write {}", path);
+        return false;
+    }
+    return true;
+}
+
+static GLuint dump_fbo() {
+    static GLuint fbo = 0;
+    if (!fbo) glGenFramebuffers(1, &fbo);
+    return fbo;
+}
+
+void vr_frame_dump_eye_image(unsigned tex, int w, int h, int array_layers, int eye) {
+    if (!vr_frame_dump_due() || w <= 0 || h <= 0) return;
+    const GLuint fbo = dump_fbo();
+    GLint prev_read = 0;
+    s_dump_eyes_tried = true;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prev_read);
+    s_dump_w = w;
+    s_dump_h = h;
+    for (int layer = 0; layer < 2; layer++) {
+        if (array_layers != 2 && layer != eye) continue;
+        const std::string name = "vr-eye" + std::to_string(layer) + dump_suffix() + ".bmp";
+        s_dump_eye_ok[layer] = read_layer(fbo, tex, array_layers == 2 ? layer : 0, array_layers == 2, w, h, name,
+                                          &s_dump_opaque[layer]);
+        if (s_dump_eye_ok[layer]) {
+            s_dump_wrote_any = true;
+            s_dump_images += name + " ";
+        }
+    }
+    glFramebufferTextureLayer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, 0, 0, 0);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(prev_read));
+}
+
+void vr_frame_dump_2d_image(unsigned tex, int w, int h, const char* what) {
+    if (!vr_frame_dump_due() || w <= 0 || h <= 0) return;
+    GLint prev_read = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prev_read);
+    const std::string name = std::string("vr-") + what + dump_suffix() + ".bmp";
+    unsigned opaque = 0;
+    if (read_layer(dump_fbo(), tex, 0, false, w, h, name, &opaque)) {
+        s_dump_wrote_any = true;
+        s_dump_images += name + " ";
+    }
+    glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(prev_read));
+}
+
+void vr_frame_dump_finish(const VrFrameDumpState& s) {
+    if (!s_dump_frame_armed) return;
+    s_dump_frame_armed = false;
+    const bool eyes_incomplete = s_dump_eyes_tried && !(s_dump_eye_ok[0] && s_dump_eye_ok[1]);
+    if (!s_dump_wrote_any || eyes_incomplete) {
+        if ((s_dump_eyes_tried || s_dump_wrote_any) && ++s_dump_failures >= 2) {
+            // The images were drawn but reading or writing them failed twice (full disk, bad folder).
+            s_dump_gave_up = true;
+            spdlog::warn("[vr-dump] giving up: the images could not be read or written ({} attempts)", s_dump_failures);
+            return;
+        }
+        // Nothing drawn this frame (a reprojected frame): stay armed for the next one.
+        if (++s_dump_waits == 1 || s_dump_waits % 120 == 0) {
+            spdlog::info("[vr-dump] armed, but XR frame {} drew nothing to dump ({} so far)", s.xr_frame, s_dump_waits);
+        }
+        return;
+    }
+    const std::string suffix = dump_suffix();
+    const std::string path = vr_frame_dump_dir() + "/vr-state" + suffix + ".txt";
+    if (FILE* f = fopen(path.c_str(), "w")) {
+        fprintf(f, "xr_frame=%llu forced=%d diag_yaw=%.1f diag_roll=%.1f multiview=%d refresh_hz=%u gameplay_s=%.1f\n",
+                static_cast<unsigned long long>(s.xr_frame), s.forced, s.diag_yaw, s.diag_roll, s.multiview,
+                s.refresh_hz, vr_frame_gameplay_seconds());
+        fprintf(f, "head_pos=%.3f,%.3f,%.3f head_quat=%.4f,%.4f,%.4f,%.4f\n", s.head_pos[0], s.head_pos[1],
+                s.head_pos[2], s.head_quat[0], s.head_quat[1], s.head_quat[2], s.head_quat[3]);
+        for (int e = 0; e < 2; e++) {
+            fprintf(f, "eye%d_pos=%.4f,%.4f,%.4f fov_l_r_u_d=%.4f,%.4f,%.4f,%.4f\n", e, s.eye_pos[e][0],
+                    s.eye_pos[e][1], s.eye_pos[e][2], s.eye_fov[e][0], s.eye_fov[e][1], s.eye_fov[e][2],
+                    s.eye_fov[e][3]);
+        }
+        const float dx = s.eye_pos[1][0] - s.eye_pos[0][0], dy = s.eye_pos[1][1] - s.eye_pos[0][1],
+                    dz = s.eye_pos[1][2] - s.eye_pos[0][2];
+        fprintf(f, "ipd_m=%.4f\n", std::sqrt(dx * dx + dy * dy + dz * dz));
+        fprintf(f, "images=%s\n", s_dump_images.c_str());
+        if (s_dump_eyes_tried) {
+            fprintf(f, "eye=%dx%d opaque_pct=%u/%u\n", s_dump_w, s_dump_h, s_dump_opaque[0], s_dump_opaque[1]);
+        }
+        fprintf(f, "%s\n", s.layers ? s.layers : "");
+        fprintf(f, "swapchain_format=0x%llx (0x8c43 = GL_SRGB8_ALPHA8; glReadPixels may return linear values on some "
+                   "drivers, so compare with the displayed image before trusting absolute levels)\n",
+                s.swapchain_format);
+        fclose(f);
+    }
+    spdlog::info("[vr-dump] wrote {} vr-state{}.txt in {} (xr frame {})", s_dump_images, suffix, vr_frame_dump_dir(),
+                 s.xr_frame);
+    s_dumps_written++;
+    s_last_dump_frame = s.xr_frame;
+}
+
+// ---------------------------------------------------------------------------------- GPU timer
+
+namespace {
+// GL_EXT_disjoint_timer_query, ES entry points looked up at run time.
+constexpr GLenum kTimeElapsedExt = 0x88BF;
+constexpr GLenum kGpuDisjointExt = 0x8FBB;
+constexpr GLenum kQueryResultAvailableExt = 0x8867;
+constexpr GLenum kQueryResultExt = 0x8866;
+typedef void (*PFN_genq)(GLsizei, GLuint*);
+typedef void (*PFN_beginq)(GLenum, GLuint);
+typedef void (*PFN_endq)(GLenum);
+typedef void (*PFN_getqui)(GLuint, GLenum, GLuint*);
+typedef void (*PFN_getqui64)(GLuint, GLenum, unsigned long long*);
+PFN_genq p_gen;
+PFN_beginq p_begin;
+PFN_endq p_end;
+PFN_getqui p_get_ui;
+PFN_getqui64 p_get_ui64;
+bool s_gpu_tried = false, s_gpu_ok = false, s_query_open = false;
+GLuint s_queries[8];
+bool s_query_pending[8];
+int s_query_head = 0;
+float s_gpu_ms_this_frame = -1.0f;
+
+void gpu_init() {
+    if (s_gpu_tried) return;
+    s_gpu_tried = true;
+    const char* ext = reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS));
+    if (!ext || !strstr(ext, "GL_EXT_disjoint_timer_query")) {
+        spdlog::info("[vr-perf] GPU timer: GL_EXT_disjoint_timer_query not advertised, gpu=n/a");
+        return;
+    }
+    p_gen = reinterpret_cast<PFN_genq>(eglGetProcAddress("glGenQueriesEXT"));
+    p_begin = reinterpret_cast<PFN_beginq>(eglGetProcAddress("glBeginQueryEXT"));
+    p_end = reinterpret_cast<PFN_endq>(eglGetProcAddress("glEndQueryEXT"));
+    p_get_ui = reinterpret_cast<PFN_getqui>(eglGetProcAddress("glGetQueryObjectuivEXT"));
+    p_get_ui64 = reinterpret_cast<PFN_getqui64>(eglGetProcAddress("glGetQueryObjectui64vEXT"));
+    if (!p_gen || !p_begin || !p_end || !p_get_ui || !p_get_ui64) {
+        spdlog::info("[vr-perf] GPU timer: entry points missing, gpu=n/a");
+        return;
+    }
+    p_gen(8, s_queries);
+    s_gpu_ok = true;
+    spdlog::info("[vr-perf] GPU timer ready (GL_EXT_disjoint_timer_query)");
+}
+
+// Pick up finished queries; never waits.
+void gpu_collect() {
+    if (!s_gpu_ok) return;
+    VRW_SCOPE(VRW_GL_READBACK); // glGet*/query reads: counted so they show up in [vr-wait] gl
+    GLint disjoint = 0;
+    glGetIntegerv(kGpuDisjointExt, &disjoint);
+    for (int i = 0; i < 8; i++) {
+        if (!s_query_pending[i]) continue;
+        GLuint avail = 0;
+        p_get_ui(s_queries[i], kQueryResultAvailableExt, &avail);
+        if (!avail) continue;
+        unsigned long long ns = 0;
+        p_get_ui64(s_queries[i], kQueryResultExt, &ns);
+        s_query_pending[i] = false;
+        if (!disjoint) s_gpu_ms_this_frame = static_cast<float>(ns / 1.0e6);
+    }
+}
+} // namespace
+
+void vr_frame_gpu_begin() {
+    // timing=1 or 2 read GPU time; timing=3 is [vr-wait] alone (the query reads below may themselves
+    // make the threaded driver sync, so a run without them shows what the game does without them).
+    const int timing = vr_frame_diag().timing;
+    if (timing != 1 && timing != 2) return;
+    gpu_init();
+    if (!s_gpu_ok || s_query_open || s_query_pending[s_query_head]) return;
+    p_begin(kTimeElapsedExt, s_queries[s_query_head]);
+    s_query_open = true;
+}
+
+void vr_frame_gpu_end() {
+    if (!s_gpu_ok || !s_query_open) return;
+    p_end(kTimeElapsedExt);
+    s_query_pending[s_query_head] = true;
+    s_query_head = (s_query_head + 1) & 7;
+    s_query_open = false;
+}
+
+// ---------------------------------------------------------------------------------- [vr-perf]
+
+namespace {
+sfvr_perf s_perf;
+bool s_perf_init = false;
+double s_clock_s = 0.0;       // our own running clock, advanced by the samples' wall times
+double s_wait_sum_ms = 0.0, s_eyes_pass_sum_ms = 0.0, s_tick_max_ms = 0.0;
+unsigned long s_frames = 0, s_eye_frames = 0, s_ticks = 0, s_unrendered = 0;
+} // namespace
+
+void vr_frame_perf_sample(const VrFramePerfSample& s) {
+    // Stages are the CPU cost of the frame minus the time spent blocked in xrWaitFrame.
+    // tick is the game logic amortized over the XR frames (it runs once per 20 Hz tick), eyes is
+    // the eye pass CPU time (reprojected frames count as zero), hud the HUD quad pass, other the rest
+    // of the frame: input, the XR calls, ImGui, swapchain handling.
+    static const char* const names[] = { "tick", "eyes", "hud", "other" };
+    if (!s_perf_init) {
+        sfvr_perf_init(&s_perf, 10.0, names, 4);
+        s_perf_init = true;
+    }
+    s_clock_s += s.since_last_ms / 1000.0;
+    gpu_collect();
+
+    double other = s.frame_ms - s.wait_ms - s.eyes_ms - s.hud_ms;
+    if (other < 0.0) other = 0.0;
+    const float stages[4] = { static_cast<float>(s.tick_ms), static_cast<float>(s.eyes_ms),
+                              static_cast<float>(s.hud_ms), static_cast<float>(other) };
+    // One multiview pass draws both eyes, so both eye= fields are that pass. 0 on a frame that
+    // only reprojected.
+    const float eye_ms = static_cast<float>(s.eyes_ms);
+    const float eye[2] = { eye_ms, eye_ms };
+    const int missed = s.period_ms > 0.0f && s.since_last_ms > 1.5 * s.period_ms;
+
+    s_frames++;
+    s_wait_sum_ms += s.wait_ms;
+    if (s.eyes_ms > 0.0) {
+        s_eye_frames++;
+        s_eyes_pass_sum_ms += s.eyes_ms;
+    }
+    if (s.tick_ms > 0.0) {
+        s_ticks++;
+        if (s.tick_ms > s_tick_max_ms) s_tick_max_ms = s.tick_ms;
+    }
+    if (!s.rendered) s_unrendered++;
+
+    vr_wait_frame_done();
+    sfvr_perf_add_frame(&s_perf, s_clock_s, missed, stages, eye, s_gpu_ms_this_frame);
+    s_gpu_ms_this_frame = -1.0f;
+
+    char line[256];
+    if (sfvr_perf_poll(&s_perf, s_clock_s, line, sizeof(line))) {
+        spdlog::info("{} wait={:.2f}ms period={:.1f}ms ticks={} tick_max={:.2f}ms eye_passes={} eye_pass_mean={:.2f}ms "
+                     "not_rendered={} (tick amortized over XR frames; eye= is the multiview pass, both eyes)",
+                     line, s_frames ? s_wait_sum_ms / static_cast<double>(s_frames) : 0.0, s.period_ms, s_ticks,
+                     s_tick_max_ms, s_eye_frames, s_eye_frames ? s_eyes_pass_sum_ms / static_cast<double>(s_eye_frames) : 0.0,
+                     s_unrendered);
+        s_wait_sum_ms = s_eyes_pass_sum_ms = s_tick_max_ms = 0.0;
+        s_frames = s_eye_frames = s_ticks = s_unrendered = 0;
+        vr_wait_report();
+    }
+}
+
+// ---------------------------------------------------------------------------------- [vr-wait]
+
+namespace {
+const char* const kCatNames[VRW_CAT_COUNT] = {
+    "draw",        "vbo_wait",   "vbo_copy",  "draw_state",  "uniform",     "shader_switch", "shader_build",
+    "tex_upload",  "tex_state",  "tex_alloc", "fb_bind",     "fb_clear",    "fb_blit",       "flush_fence",
+    "gl_get_read", "tex_import", "acquire",   "wait_image",  "release",     "begin_frame",   "end_frame",
+    "wait_frame",  "sync_actions", "locate_views", "locate_space", "action_state", "poll_event", "xr_other",
+};
+const char* const kStageNames[VRW_ST_COUNT] = {
+    "frame",       "head",      "begin_frame", "stereo_begin", "stereo_run", "stereo_end",
+    "eye_begin",   "eye_run",   "eye_end",     "screen_begin", "screen_run", "screen_end",
+    "hud_begin",   "hud_run",   "hud_end",     "menu",         "end_frame",  "tail",
+};
+const char* const kScKinds[4] = { "eyes", "hud", "menu", "screen" };
+
+void appendf(std::string& out, const char* fmt, double a, double b, double c, double d) {
+    char buf[96];
+    snprintf(buf, sizeof(buf), fmt, a, b, c, d);
+    out += buf;
+}
+} // namespace
+
+void vr_wait_frame_done() {
+    if (g_vr_wait_on) g_vrw.frames++;
+}
+
+void vr_wait_report() {
+    if (!g_vr_wait_on) return;
+    const VrWaitState& w = g_vrw;
+    if (w.frames == 0) return;
+    const double nf = static_cast<double>(w.frames);
+    const double ms = 1.0e-6 / nf; // ns total -> ms per frame
+
+    // 1. frame phases: wall / game-thread CPU / leaf time inside (GL + XR scopes), runs per frame
+    std::string st;
+    for (int i = 0; i < VRW_ST_COUNT; i++) {
+        if (w.st_runs[i] == 0) continue;
+        st += ' ';
+        st += kStageNames[i];
+        appendf(st, "=%.2f/%.2f/%.2f(n%.2f)", w.st_wall_ns[i] * ms, w.st_cpu_ns[i] * ms, w.st_scoped_ns[i] * ms,
+                static_cast<double>(w.st_runs[i]) / nf);
+    }
+    spdlog::info("[vr-wait] stages frames={}{} (ms per frame averaged over ALL frames incl. ones that skip the "
+                 "stage: wall/game-thread-cpu/time-in-timed-GL-and-XR-calls (n=runs per frame); wall-cpu = blocked)",
+                 w.frames, st);
+
+    // 2. OpenXR calls: wall/thread-cpu per frame (n calls per frame, slow>0.2ms per frame, max single call)
+    std::string xr;
+    for (int i = VRW_FIRST_XR; i < VRW_CAT_COUNT; i++) {
+        if (w.cat_calls[i] == 0) continue;
+        xr += ' ';
+        xr += kCatNames[i];
+        appendf(xr, "=%.2f/%.2f(n%.2f,slow%.2f,", w.cat_ns[i] * ms, w.cat_cpu_ns[i] * ms,
+                static_cast<double>(w.cat_calls[i]) / nf, static_cast<double>(w.cat_slow[i]) / nf);
+        appendf(xr, "max%.2f)", w.cat_max_ns[i] * 1.0e-6, 0, 0, 0);
+    }
+    std::string sc;
+    for (int k = 0; k < 4; k++) {
+        if (w.acquires[k] == 0 && w.releases[k] == 0) continue;
+        char b[64];
+        snprintf(b, sizeof(b), " %s=%.2f/%.2f", kScKinds[k], static_cast<double>(w.acquires[k]) / nf,
+                 static_cast<double>(w.releases[k]) / nf);
+        sc += b;
+    }
+    spdlog::info("[vr-wait] xr{} | swapchain acquire/release per frame:{} (ms per frame wall/thread-cpu "
+                 "(n calls per frame, slow>0.2ms per frame, max single call ms))",
+                 xr, sc);
+
+    // 3. GL backend + interpreter: ms per frame (n calls per frame, slow>0.2ms per frame, max single call ms)
+    std::string gl;
+    double gl_total = 0.0, slow_total = 0.0;
+    int top = -1, slowest = -1;
+    for (int i = 0; i < VRW_FIRST_XR; i++) {
+        if (w.cat_calls[i] == 0) continue;
+        gl += ' ';
+        gl += kCatNames[i];
+        appendf(gl, "=%.2f(n%.1f,slow%.2f,", w.cat_ns[i] * ms, static_cast<double>(w.cat_calls[i]) / nf,
+                static_cast<double>(w.cat_slow[i]) / nf, 0);
+        appendf(gl, "max%.2f)", w.cat_max_ns[i] * 1.0e-6, 0, 0, 0);
+        if (i != VRW_INTERP_TEXIMPORT) gl_total += w.cat_ns[i] * ms;
+        slow_total += static_cast<double>(w.cat_slow[i]) / nf;
+        if (top < 0 || w.cat_ns[i] > w.cat_ns[top]) top = i;
+        if (slowest < 0 || w.cat_max_ns[i] > w.cat_max_ns[slowest]) slowest = i;
+    }
+    spdlog::info("[vr-wait] gl{} | gl_total={:.2f}ms slow_calls={:.2f}/frame top_total={}({:.2f}ms) "
+                 "slowest_call={}({:.2f}ms) (ms per frame (n calls per frame, slow>0.2ms per frame, max single call "
+                 "ms); tex_import is CPU decode, exclusive of its GL calls)",
+                 gl, gl_total, slow_total, top >= 0 ? kCatNames[top] : "-", top >= 0 ? w.cat_ns[top] * ms : 0.0,
+                 slowest >= 0 ? kCatNames[slowest] : "-", slowest >= 0 ? w.cat_max_ns[slowest] * 1.0e-6 : 0.0);
+
+    g_vrw = VrWaitState{};
+}
+
+#endif // SOH_STEAM_FRAME
