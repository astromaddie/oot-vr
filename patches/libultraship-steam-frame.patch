+// stick move the focus, A activates, B or a short View press cancels, X/Y are the face-left/up
+// keys, the bumpers are the L1/R1 tab keys. Edge-triggered so a held button is one press.
+static void FeedMenuNavFromXrPad(ImGuiIO* io) {
+    static bool sPrev[16] = {};
+    const uint16_t fb = vr_get_frame_buttons();
+    const uint16_t left = vr_get_controller_buttons(0);
+    const uint16_t right = vr_get_controller_buttons(1);
+    struct Map {
+        ImGuiKey key;
+        bool down;
+    };
+    const Map maps[] = {
+        { ImGuiKey_GamepadDpadUp, (fb & VR_FBTN_DPAD_UP) != 0 },
+        { ImGuiKey_GamepadDpadDown, (fb & VR_FBTN_DPAD_DOWN) != 0 },
+        { ImGuiKey_GamepadDpadLeft, (fb & VR_FBTN_DPAD_LEFT) != 0 },
+        { ImGuiKey_GamepadDpadRight, (fb & VR_FBTN_DPAD_RIGHT) != 0 },
+        { ImGuiKey_GamepadFaceDown, (right & VR_BTN_PRIMARY) != 0 },      // A
+        { ImGuiKey_GamepadFaceRight, (right & VR_BTN_SECONDARY) != 0 || (fb & VR_FBTN_BACK) != 0 }, // B, View
+        { ImGuiKey_GamepadFaceLeft, (left & VR_BTN_PRIMARY) != 0 },       // X
+        { ImGuiKey_GamepadFaceUp, (left & VR_BTN_SECONDARY) != 0 },       // Y
+        { ImGuiKey_GamepadL1, (fb & VR_FBTN_BUMPER_L) != 0 },
+        { ImGuiKey_GamepadR1, (fb & VR_FBTN_BUMPER_R) != 0 },
+    };
+    int i = 0;
+    for (const Map& m : maps) {
+        if (m.down != sPrev[i]) {
+            io->AddKeyEvent(m.key, m.down);
+            sPrev[i] = m.down;
+        }
+        i++;
+    }
+    float lx = 0.0f, ly = 0.0f;
+    vr_get_thumbstick(0, &lx, &ly);
+    io->AddKeyAnalogEvent(ImGuiKey_GamepadLStickLeft, lx < -0.25f, lx < -0.25f ? -lx : 0.0f);
+    io->AddKeyAnalogEvent(ImGuiKey_GamepadLStickRight, lx > 0.25f, lx > 0.25f ? lx : 0.0f);
+    io->AddKeyAnalogEvent(ImGuiKey_GamepadLStickUp, ly > 0.25f, ly > 0.25f ? ly : 0.0f);
+    io->AddKeyAnalogEvent(ImGuiKey_GamepadLStickDown, ly < -0.25f, ly < -0.25f ? -ly : 0.0f);
+    io->ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+}
