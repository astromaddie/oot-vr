diff --git a/include/fast/vr_frame.h b/include/fast/vr_frame.h
new file mode 100644
index 00000000..51f27c53
--- /dev/null
+++ b/include/fast/vr_frame.h
@@ -0,0 +1,73 @@
+// Steam Frame diagnostics that need GL or the frame loop: eye dumps and the [vr-perf] line.
+// Steam Frame build only. The config these read is vr_frame_diag.h; vr_openxr.cpp calls in
+// from a handful of hooks so the Quest build never sees any of it.
+#pragma once
+
+#ifdef SOH_STEAM_FRAME
+
+#include <cstdint>
+
+// ---- quitting ---------------------------------------------------------------------------------
+// When the runtime asks the app to end, the settings are saved and `fn` is run (on its own thread,
+// waited for at most 2.5 s) before the process exits: the game registers "finish any save in flight".
+void vr_frame_set_quit_flush(void (*fn)());
+
+// ---- dumps (dump_frame / dump_at / dump_when / dump_count, vr_frame_diag.h) ---------------------
+// Called once per XR frame that located views, with a running XR frame number.
+void vr_frame_dump_begin(uint64_t xr_frame);
+// This frame's presentation kind: 0 immersive, 1 3D cinema, 2 flat cinema, 3 flat panel.
+void vr_frame_dump_set_kind(int kind);
+// True while this XR frame's images should be dumped (ask before releasing a swapchain image).
+// Decided once per frame: from dump_frame N / dump_at seconds on, in the dump_when kind, every
+// dump_every frames for dump_count dumps. A frame that draws nothing keeps it armed.
+bool vr_frame_dump_due();
+
+struct VrFrameDumpState {
+    uint64_t xr_frame = 0;
+    float head_pos[3] = {};
+    float head_quat[4] = {};
+    float eye_pos[2][3] = {};
+    float eye_fov[2][4] = {};       // left, right, up, down (radians)
+    long long swapchain_format = 0;
+    bool multiview = false;
+    bool forced = false;            // force_render, synthetic head
+    uint32_t refresh_hz = 0;
+    float diag_yaw = 0.0f;
+    float diag_roll = 0.0f;
+    const char* layers = nullptr;   // what the frame submitted (presentation, layers, cinema views, HUD pose)
+};
+
+// Read an image back and write it to <data>/vr-dumps: the eyes as vr-eye0.bmp / vr-eye1.bmp (with
+// array_layers == 2 both are layers of `tex`, multiview; otherwise `eye` says which), a 2D target
+// (the flat panel, the HUD quad) as vr-<what>.bmp. A series (dump_count > 1) adds -2, -3, ... to
+// the names. Blocking glReadPixels: dump frames only.
+void vr_frame_dump_eye_image(unsigned tex, int w, int h, int array_layers, int eye);
+void vr_frame_dump_2d_image(unsigned tex, int w, int h, const char* what);
+// At the end of the frame: writes vr-state.txt (with the same suffix) if anything was written.
+void vr_frame_dump_finish(const VrFrameDumpState& s);
+
+// The game's first gameplay tick (the first presentation request). dump_at and diag_pause_at
+// count from here, so a slow first start (oot.o2r extraction) does not move them.
+void vr_frame_note_gameplay();
+double vr_frame_gameplay_seconds(); // <0 before gameplay started
+
+// ---- [vr-perf] ---------------------------------------------------------------------------------
+// One call per XR frame, after the frame's work is known. All times in milliseconds.
+struct VrFramePerfSample {
+    double wait_ms = 0.0;      // blocked in xrWaitFrame
+    double eyes_ms = 0.0;      // CPU time of the eye pass (0 on a reprojected frame)
+    double hud_ms = 0.0;       // CPU time of the HUD quad pass
+    double frame_ms = 0.0;     // whole DrawAndRunGraphicsCommands, wait included
+    double tick_ms = 0.0;      // game logic that ran since the last sample (0 on most frames)
+    float period_ms = 0.0f;    // the runtime's display period
+    double since_last_ms = 0.0; // wall time since the previous sample
+    bool rendered = false;     // shouldRender was true
+};
+void vr_frame_perf_sample(const VrFramePerfSample& s);
+
+// GPU time of the eye pass (GL_EXT_disjoint_timer_query), only with `timing` and a driver that
+// has the extension. Results are read a few frames late and never waited on.
+void vr_frame_gpu_begin();
+void vr_frame_gpu_end();
+
+#endif // SOH_STEAM_FRAME
diff --git a/include/fast/vr_frame_diag.h b/include/fast/vr_frame_diag.h
new file mode 100644
index 00000000..4b707608
--- /dev/null
+++ b/include/fast/vr_frame_diag.h
@@ -0,0 +1,65 @@
+// Steam Frame bring-up diagnostics: the vr-diag.ini file and the plain-C++ helpers around it.
+//
+// Everything here exists only in the Frame build (SOH_STEAM_FRAME). vr-diag.ini lives in the
+// data folder (/sdcard/Documents/OoTVR on the Frame = the headset's ~/Documents/OoTVR) and is
+// written by tools/steam_frame/deploy.sh --diag KEY=VAL. Diagnostics stay out of the in-VR menus.
+//
+// This header has no OpenXR, GL or ImGui in it so the host test (tools/steam_frame/tests) can
+// build the parser and the BMP writer without an Android toolchain.
+#pragma once
+
+#ifdef SOH_STEAM_FRAME
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+struct VrFrameDiag {
+    bool present = false;       // vr-diag.ini existed
+    bool force_render = false;  // draw AND submit while the runtime says shouldRender=false, with a
+                                // synthetic head at 1.6 m; the game keeps being stepped
+    float diag_yaw = 0.0f;      // degrees, the synthetic head's yaw (positive turns left, OpenXR +Y)
+    int dump_frame = 0;         // from XR frame N on, dump the first frame that draws the eyes (0 = off)
+    int timing = 0;             // 1: GPU time per eye pass (GL_EXT_disjoint_timer_query, read late)
+                                // 2: that plus the [vr-wait] instrumentation (vr_wait.h)
+                                // 3: [vr-wait] only, without the GPU timer queries
+    bool autostart = false;     // get past the title with no controller (a debug-save warp)
+    int autostart_entrance = 0x00EE; // the entrance autostart warps to (0x00EE = Kokiri Forest)
+    int stereo_divisor = 0;     // overrides the gVrStereoDivisor CVar for this run (1..4), 0 = leave it
+    float diag_roll = 0.0f;     // degrees, the synthetic head's roll (positive tilts the head left), to
+                                // check that the HUD and text stay level
+    float dump_at = 0.0f;       // seconds after gameplay starts (0 = off); with dump_frame both must pass
+    std::string dump_when;      // dump only in this presentation: any (default), immersive, cinema,
+                                // cinema3d, flat_cinema, panel
+    int dump_count = 1;         // dumps in the series (files get -2, -3, ...)
+    int dump_every = 90;        // XR frames between the dumps of a series
+    int autostart_slot = 0;     // autostart: load save file N (1..3) instead of the debug save
+    bool autostart_new_game = false; // autostart: a fresh file (not saved) with the new-game intro
+    float diag_pause_at = 0.0f; // seconds after gameplay starts: press Start once (0 = off)
+    int refresh_rate = 0;       // overrides gVrRefreshRate for the run (Hz, the highest offered rate at or
+                                // below it is requested; 0 = leave the setting)
+    float resolution_scale = 0.0f; // overrides gVrResolutionScale for the run (0.75..1.5, 0 = leave it)
+    bool diag_menu_open = false; // open the VR settings menu 2 s into gameplay (the parked right hand
+                                 // points at it: dumps show the laser pointer)
+};
+
+// Parse "key = value" lines (# ; and [section] lines are comments). Unknown keys are reported
+// through `unknown` (one name per call) so the caller can log them; may be null.
+void vr_frame_diag_parse(const char* text, VrFrameDiag* out, void (*unknown)(const char* key));
+
+// The settings, read once from <data folder>/vr-diag.ini. Never null.
+const VrFrameDiag& vr_frame_diag();
+
+// Synthetic head for force_render: 1.6 m up, yaw = diag_yaw. Eyes sit +-32 mm to the side along
+// the head's own right vector (64 mm IPD). quat is x,y,z,w.
+void vr_frame_synth_head(const VrFrameDiag& d, float head_pos[3], float head_quat[4]);
+void vr_frame_synth_eye(const VrFrameDiag& d, int eye, float pos[3], float quat[4]);
+
+// 24-bit BMP of tightly packed RGBA8 rows, bottom-up (GL's read order). Returns false when the
+// file cannot be written. opaque_pct (optional) gets the share of pixels with alpha >= 250.
+bool vr_frame_write_bmp24(const char* path, const uint8_t* rgba, int w, int h, unsigned* opaque_pct);
+
+// Where dumps go: <data folder>/vr-dumps (created on demand). Returns the directory.
+std::string vr_frame_dump_dir();
+
+#endif // SOH_STEAM_FRAME
