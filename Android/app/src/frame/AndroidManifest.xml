<?xml version="1.0" encoding="utf-8"?>
<!--
    Merged over src/main for the "frame" build type: the Valve Steam Frame, whose
    Android container ("Lepton", Android 11, API 30) runs the app on SteamVR's OpenXR
    runtime. What the Quest manifest declares that the Frame must not (or need not):

      - android.hardware.vr.headtracking as a *required* feature. Lepton does not
        advertise it (pm list features shows only the Vulkan ones), so the install
        would be refused.
      - the Quest shell metadata (supported devices, focus-aware).

    minSdk stays 24 (Lepton is API 30), targetSdk 33 installs fine on it.
    The Meta VR launcher category on the activity's intent filter is left alone: an
    unknown category on a filter is harmless, and the activity still has LAUNCHER.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.vr.headtracking"
        tools:node="remove" />

    <application>
        <meta-data
            android:name="com.oculus.supportedDevices"
            tools:node="remove" />

        <activity android:name=".MainActivity">
            <meta-data
                android:name="com.oculus.vr.focusaware"
                tools:node="remove" />
        </activity>
    </application>
</manifest>
