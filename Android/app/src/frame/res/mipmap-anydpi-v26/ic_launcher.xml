<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon the manifest asks for (@mipmap/ic_launcher). The real icon PNGs are not in
    git (*.png is ignored), so a clean checkout has no mipmap resource at all and the build stops in
    resource linking. This adaptive icon is built from the vector drawables that are in git. The
    Frame (Lepton, API 30) shows apps by their Steam library entry, not by this icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
